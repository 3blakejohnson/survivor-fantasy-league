package templates

import "github.com/a-h/templ"

templ HomePage() {
	<html>
		<head>
			<title>Survivor Fantasy League</title>
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<script src="https://unpkg.com/htmx.org@1.9.6"></script>
			<link rel="stylesheet" href="/static/style.css">
		</head>
		<body>
			<header>
				<h1>Survivor Fantasy League</h1>
			</header>

			<main>
				<p>Welcome to the Survivor Fantasy League! Choose your players, track stats, and see how you rank.</p>

				<!-- HTMX Example: Click to Load Content -->
				<button hx-get="/about" hx-target="#content" hx-swap="innerHTML">
					Load About Info
				</button>

				<div id="content"></div>
			</main>
		</body>
	</html>
}
