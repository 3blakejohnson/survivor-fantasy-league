package templates

templ LoginPage() {
	<html>
		<head>
			<title>Login | Survivor Fantasy League</title>
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<link rel="stylesheet" href="/static/style.css">
		</head>
		<body>
			<header>
				<h1>Survivor Fantasy League</h1>
			</header>

			<main class="auth-page">
				<section class="auth-card">
					<h2>Log in</h2>
					<p class="muted">Sign in to manage your leagues and set your roster.</p>

					<form class="auth-form" method="post" action="/login">
						<label for="username">Username</label>
						<input id="username" name="username" type="text" placeholder="your-username" autocomplete="off" required />

						<label for="password">Password</label>
						<input id="password" name="password" type="password" placeholder="Enter your password" autocomplete="off" required />

						<div class="checkbox-row">
							<input id="remember" name="remember" type="checkbox" />
							<label for="remember">Remember me</label>
						</div>

						<button type="submit">Continue</button>
					</form>

					<p class="form-footer">
						Need an account?
						<a href="#">Create one</a>
					</p>
				</section>
			</main>
		</body>
	</html>
}
